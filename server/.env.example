# ---- Server ----
PORT=4000
# Comma-separated list of allowed origins for the web app (use * only in development)
CORS_ORIGINS=*
# REQUIRED in production: long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d
# SQLite database file
DATABASE_PATH=./data/app.db

# ---- Translation ----
# free   = Google's public web endpoint, no key. Good for local testing ONLY (rate-limited, no SLA).
# google = Google Cloud Translation v2 (recommended for production: ~100-200 ms latency)
# deepl  = DeepL API (very high quality, Arabic supported)
# claude = Anthropic Claude (context-aware, best for idioms/dialects; higher latency)
TRANSLATION_PROVIDER=free

GOOGLE_TRANSLATE_API_KEY=
DEEPL_API_KEY=
# Use https://api.deepl.com for paid plans
DEEPL_API_URL=https://api-free.deepl.com

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---- App ----
APP_NAME=Live Translate

# ---- Google sign-in (optional) ----
# Comma-separated OAuth client IDs from Google Cloud Console: Web, iOS and Android.
GOOGLE_CLIENT_IDS=

# ---- Email: verification codes & password reset ----
# Without SMTP_HOST, codes are printed in this terminal (fine for local testing).
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true SMTP_USER=you@gmail.com SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Live Translate <no-reply@your-domain.com>"

# ---- AI meeting summaries (optional) ----
# gemini = Google Gemini (key from https://aistudio.google.com/apikey)
# claude = Anthropic Claude (uses ANTHROPIC_API_KEY and CLAUDE_MODEL from above)
# Leave SUMMARY_PROVIDER empty to use whichever key is set (Gemini first). With no key, the feature is hidden.
SUMMARY_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---- Operations ----
# Error monitoring (optional): https://sentry.io → create a Node project → DSN
SENTRY_DSN=
BACKUP_DIR=./data/backups
BACKUP_KEEP=14
