# ---- Server ----
PORT=4000
# Comma-separated list of allowed origins for the web app (use * only in development)
CORS_ORIGINS=*
# REQUIRED in production: long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d
# PostgreSQL connection string (required). With Neon: Project > Connect > copy the string for the
# `development` branch here, and the `main` branch's string into .env.production.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Old SQLite file: only read by the one-time `npm run import-sqlite`
DATABASE_PATH=./data/app.db

# ---- Translation ----
# free   = Google's public web endpoint, no key. Good for local testing ONLY (rate-limited, no SLA).
# google = Google Cloud Translation v2 (recommended for production: ~100-200 ms latency)
# deepl  = DeepL API (very high quality, Arabic supported)
# azure  = Microsoft Azure AI Translator (fast, inexpensive; free F0 tier: 2M characters/month)
# claude = Anthropic Claude (context-aware, best for idioms/dialects; higher latency)
TRANSLATION_PROVIDER=free
# Optional: a cheaper provider for in-progress sentences only (blank = same as TRANSLATION_PROVIDER)
TRANSLATION_PREVIEW_PROVIDER=

GOOGLE_TRANSLATE_API_KEY=
DEEPL_API_KEY=
# Use https://api.deepl.com for paid plans
DEEPL_API_URL=https://api-free.deepl.com
# Azure Translator resource > Keys and Endpoint (region e.g. westus2, or global)
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=global
# Monthly character allowance (Azure F0 = 2000000). See usage with `npm run usage`; the log warns at 80% and 100%.
TRANSLATION_MONTHLY_LIMIT=2000000

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---- App ----
APP_NAME=LisanCast

# ---- Google sign-in (optional) ----
# Comma-separated OAuth client IDs from Google Cloud Console: Web, iOS and Android.
GOOGLE_CLIENT_IDS=

# ---- Email: verification codes & password reset ----
# Without SMTP_HOST, codes are printed in this terminal (fine for local testing).
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true SMTP_USER=you@gmail.com SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="LisanCast <no-reply@your-domain.com>"

# ---- AI meeting summaries (optional) ----
# gemini = Google Gemini (key from https://aistudio.google.com/apikey)
# claude = Anthropic Claude (uses ANTHROPIC_API_KEY and CLAUDE_MODEL from above)
# Leave SUMMARY_PROVIDER empty to use whichever key is set (Gemini first). With no key, the feature is hidden.
SUMMARY_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Summaries are written automatically when a session ends. Set to false to only generate them on request.
AUTO_SUMMARY=true
# Natural read-aloud voice for listeners (uses GEMINI_API_KEY). Set TTS_ENABLED=false to use the phones' own voices instead.
TTS_ENABLED=true
TTS_MODEL=gemini-3.8-flash-lite-tts
TTS_VOICE=Charon

# ---- Operations ----
# Error monitoring (optional): https://sentry.io → create a Node project → DSN
SENTRY_DSN=
BACKUP_DIR=./data/backups
BACKUP_KEEP=14
