# Backend URL. Leave empty in development: the app auto-detects your computer's address
# (localhost on web, the Expo dev-server IP on phones).
EXPO_PUBLIC_API_URL=
# Public URL of the web app, used for share links / QR codes (e.g. https://app.your-domain.com)
EXPO_PUBLIC_WEB_URL=

# Google sign-in (optional). Create OAuth client IDs in Google Cloud Console (see README):
#   Web client ID  -> used on web and by Android
#   iOS client ID  -> used on iPhone/iPad
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Shown in the Privacy Policy and Terms of Use
EXPO_PUBLIC_COMPANY_NAME=Live Translate
EXPO_PUBLIC_SUPPORT_EMAIL=support@your-domain.com
