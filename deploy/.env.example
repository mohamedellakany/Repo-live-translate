API_DOMAIN=api.your-domain.com
APP_DOMAIN=app.your-domain.com
# Optional extra names, each starting with ", ". API aliases are served like API_DOMAIN (keeps older phone
# builds working); app aliases redirect to APP_DOMAIN (bare domain, www, old addresses on printed QR codes).
API_ALIASES=
APP_ALIASES=", your-domain.com, www.your-domain.com"
